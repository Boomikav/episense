# =============================================================================
# EpiSense Production & Development Environment Configuration Checklist
# =============================================================================

# --- Backend Configuration (Render / Persistent Host) ---
PORT=8008
HOST=0.0.0.0
EPISENSE_DB_PATH=/var/data/surveillance_store.sqlite
CORS_ORIGINS=https://episense.vercel.app,https://*.vercel.app,http://localhost:5173
EPISENSE_PRELOAD_CORPUS=1
EPISENSE_ENV=production
EPISENSE_LOG_LEVEL=INFO
EPISENSE_DEBUG=false

# --- Frontend Configuration (Vercel) ---
# Set this in Vercel Project Settings > Environment Variables:
VITE_API_BASE_URL=https://YOUR-BACKEND-DOMAIN.onrender.com

# --- NLP & Geospatial Pipelines ---
EPISENSE_NLP_BACKEND=spacy
EPISENSE_NER_MODEL=en_core_sci_sm
EPISENSE_ASSERTION_METHOD=rule_based
EPISENSE_GEO_SCOPE=India
EPISENSE_GEO_ADMIN_LEVEL=2

# --- Fusion & Alert Scoring ---
EPISENSE_FUSION_WINDOW_DAYS=7
EPISENSE_FUSION_GEO_LEVEL=admin_2
EPISENSE_SCORE_WEIGHT_ANOMALY=0.30
EPISENSE_SCORE_WEIGHT_THREAT=0.25
EPISENSE_SCORE_WEIGHT_EVIDENCE=0.20
EPISENSE_SCORE_WEIGHT_CERTAINTY=0.15
EPISENSE_SCORE_WEIGHT_SPATIAL=0.10
